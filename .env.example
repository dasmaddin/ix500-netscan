# Scanner IP address. Leave empty to find the scanner by broadcast.
IX500_HOST=
# Scanner password. Factory default: the last 4 digits of the serial number.
IX500_PASSWORD=
# Network interface toward the scanner (optional, detected from the routing table).
IX500_IFACE=
# "auto" adopts the host ID of the computer the scanner was paired with.
HOST_ID=auto
FILENAME_TEMPLATE=scan_%Y%m%d_%H%M%S.pdf
BLANK_PAGE_DETECTION=on
BLANK_PAGE_THRESHOLD=0.0025
# local = keep the scanner reserved for this service, cloud = leave it free
DEFAULT_MODE=local
API_BIND=127.0.0.1
API_PORT=8099
LOG_LEVEL=INFO
